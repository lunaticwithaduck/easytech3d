# Public site origin (used for canonical URLs, sitemap, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Medusa Store API base URL (`commerce/`, a separate repo/service) — catalog, cart, checkout,
# orders, customer accounts and courier office lookups all go through here (server-side only).
MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa publishable API key (Admin → Settings → Publishable API Keys), scoped to the
# "Storefront" sales channel. Sent as `x-publishable-api-key` on every Store API call. Server-only
# — never exposed to the browser. Catalog reads degrade to an empty fallback when unset.
MEDUSA_PUBLISHABLE_KEY=

# Old NestJS backend — still used for newsletter/contact/back-in-stock forms and the 3D-print
# quote (STL) upload until those move into Medusa modules too.
BACKEND_API_URL=http://localhost:4000

# Product media host (object storage / CDN), once chosen. Drives next/image remotePatterns.
NEXT_PUBLIC_MEDIA_HOST=
